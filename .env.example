DATABASE_URL=postgres://your_user:your_password@localhost:5432/flagraft_db
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Log a line for every request. Off by default -- failed and slow requests are
# always logged, and the evaluation endpoint is polled often enough that a line
# per request buries everything else. Turn on while debugging.
REQUEST_LOG=false
# Seconds to cache flag evaluation state in memory per project+environment. Must be >= 1.
CACHE_TTL_SECONDS=30

# Rate limiting for client evaluation routes (/api/v1/client/*).
# RATE_LIMIT_MAX: maximum requests per window per client IP.
# RATE_LIMIT_WINDOW_MS: sliding window duration in milliseconds.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# How much of the X-Forwarded-For header to believe when working out the caller's
# IP, which is what the rate limit above counts. Leave it off unless a proxy you
# control is in front of the server.
#
#   off (default)  every caller behind a proxy looks like the proxy, so the whole
#                  deployment shares one rate limit bucket
#   on, no proxy   any caller can invent an IP per request and walk past the limit
#
# Accepts true, false, a hop count (1), or a comma-separated list of trusted
# proxy addresses and CIDR ranges (10.0.0.0/8,192.168.1.1).
# TRUST_PROXY=1

# Tests read this directly. Migrate this database before running integration tests.
# TEST_DATABASE_URL=postgres://your_user:your_password@localhost:5432/flagraft_test_db

# Secret used to sign and verify JWTs. Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-before-production

# After migrations, create the first admin credential with:
# pnpm admin:create-root-key

# SMTP for invite emails. Leave SMTP_HOST unset to disable email -- invites then
# fall back to manual sharing (the invite link is returned to the admin in the UI).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Flagraft <no-reply@yourcompany.com>
# APP_BASE_URL=https://flagraft.yourcompany.com

# Seed values -- only applied on first boot with an empty database.
# In production the server refuses to start with the default password below;
# set DEFAULT_ADMIN_PASSWORD to a strong, unique value.
DEFAULT_ADMIN_EMAIL=admin@flagraft.local
DEFAULT_ADMIN_PASSWORD=flagraft-admin
DEFAULT_ADMIN_NAME=Admin
DEFAULT_PROJECT_NAME=Default
DEFAULT_PROJECT_SLUG=default

# Admin UI only, read at build time by Vite. Origin of the API the UI calls,
# and the endpoint it displays on the Environments screen. Set this to your own
# domain when self-hosting; it defaults to http://localhost:3000.
# VITE_API_URL=https://flags.example.com
