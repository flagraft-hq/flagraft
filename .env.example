DATABASE_URL=postgres://your_user:your_password@localhost:5432/flagraft_db
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Seconds to cache flag evaluation state in memory per project+environment. Must be >= 1.
CACHE_TTL_SECONDS=30

# Rate limiting for client evaluation routes (/api/v1/client/*).
# RATE_LIMIT_MAX: maximum requests per window per client IP.
# RATE_LIMIT_WINDOW_MS: sliding window duration in milliseconds.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Tests read this directly. Migrate this database before running integration tests.
# TEST_DATABASE_URL=postgres://your_user:your_password@localhost:5432/flagraft_test_db

# After migrations, create the first admin credential with:
# pnpm admin:create-root-key
