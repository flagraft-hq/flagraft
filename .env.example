DATABASE_URL=postgres://veltra:veltra@localhost:5432/veltra
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Seconds to cache flag evaluation state in memory per project+environment. Must be >= 1.
CACHE_TTL_SECONDS=30

