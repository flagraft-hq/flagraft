{
  "name": "flagraft",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:all": "pnpm --parallel --filter . --filter @flagraft/admin-ui --include-workspace-root dev",
    "build": "tsup",
    "build:all": "pnpm -r --parallel --include-workspace-root build",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "pnpm -r --parallel --include-workspace-root typecheck",
    "test": "pnpm test:all",
    "test:all": "vitest run && pnpm -r --filter=\"./packages/**\" test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ui:dev": "pnpm --filter @flagraft/admin-ui dev",
    "ui:build": "pnpm --filter @flagraft/admin-ui build",
    "bench:seed": "tsx benchmarks/seed.ts",
    "bench:server": "tsx benchmarks/server.ts",
    "bench:sdk": "vitest bench --run benchmarks/sdk.bench.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "admin:create-root-key": "tsx src/cli/create-root-key.ts",
    "lint": "pnpm typecheck:all && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "argon2": "^0.44.0",
    "bentocache": "^1.6.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "fastify-type-provider-zod": "^2.1.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "safe-regex": "^2.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/argon2": "^0.15.4",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/safe-regex": "^1.1.6",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.27.2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "prettier": "^3.8.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.1",
    "vitest": "^2.1.8"
  }
}
